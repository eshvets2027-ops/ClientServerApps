{
  "FileStorage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSizeMb": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Title": "EventHub API",
    "Version": "v1",
    "Description": "API для керування подіями та їхніми обкладинками."
  },
  "Geocoding": {
    "BaseUrl": "https://api.geoapify.com/",
    "TimeoutSeconds": 5,
    "CacheDurationMinutes": 60,
    "NegativeCacheDurationMinutes": 10,
    "CacheSize": 1000,
    "Language": "uk",
    "CountryCode": "ua"
  }
}
